# Copy to .env (never committed). In production: /opt/docker/ai-news/.env, mode 600.

# --- Local development ---
DATABASE_URL=postgres://ainews:ainews_dev@127.0.0.1:5433/ainews
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=            # openssl rand -base64 32

# --- Production only (docker-compose.prod.yml) ---
APP_DOMAIN=ai-news.vps.troturier.fr
POSTGRES_PASSWORD=             # openssl rand -hex 24

# --- Common ---
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM="AI News <veille@mail.exemple.fr>"

# --- Optional ---
GITHUB_TOKEN=                  # raises the GitHub API rate limit (popularity filter)
# PIPELINE_DISCOVERY_MODEL=claude-sonnet-5-5
# PIPELINE_WRITE_MODEL=claude-haiku-5-5
# PIPELINE_MIN_SCORE=15
# PIPELINE_MIN_STARS=1000

# Legal notice page (/legal); every field is optional and omitted when empty
# LEGAL_PUBLISHER_NAME=
# LEGAL_CONTACT_EMAIL=
# LEGAL_HOST=                    # overrides the default hosting paragraph (OVH)
